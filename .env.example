# RedForge local configuration (copy to .env — never commit .env)
# All settings use the RF_ prefix (see redforge/config.py).

# Console runtime API proxy (server-side only; set when API is not on :8000)
# RF_API_BASE=http://127.0.0.1:8000

# Legacy alias for the LLM judge when RF_JUDGE_PROVIDER is unset.
# Values: demo (default) | astra | real
# Note: astra selects the Azure Astra LLM judge only — NOT the campaign target.
RF_LLM_PROVIDER=demo

# Explicit provider selectors (preferred over RF_LLM_PROVIDER)
# RF_TARGET_PROVIDER=demo|real
# RF_JUDGE_PROVIDER=demo|astra|real

# --- Azure OpenAI GPT Astra (Responses API) — LLM judge/validator only ---
# Required when judge provider is astra
RF_ASTRA_ENDPOINT=https://dev-agentic.openai.azure.com
RF_ASTRA_API_VERSION=2025-04-01-preview
RF_ASTRA_API_KEY=
RF_ASTRA_DEPLOYMENT=gpt-6-astra

# --- OpenAI-compatible campaign target (real mode) ---
RF_TARGET_BASE_URL=http://127.0.0.1:8901/v1
RF_TARGET_API_KEY=

# --- Operator auth (demo-labeled vs secure self-hosted) ---
# demo: RF_OPERATOR_DEMO_BOOTSTRAP=1 issues labeled operator-only sessions
# secure: password login + signed httpOnly sessions (set RF_OPERATOR_SESSION_SECRET)
RF_OPERATOR_AUTH_MODE=demo
RF_OPERATOR_DEMO_BOOTSTRAP=0
RF_OPERATOR_SESSION_SECRET=
RF_OPERATOR_AUDIT_SIGNING_KEY=
RF_OPERATOR_DB=output/live/operator.db
RF_OPERATOR_SESSION_TTL_MINUTES=30
# Secure users JSON (use password_hash pbkdf2:... in production)
# RF_OPERATOR_SECURE_USERS=[{"username":"operator","password_hash":"pbkdf2:...","role":"operator"}]
# Optional OIDC/JWKS extension
# RF_OPERATOR_OIDC_JWKS_URL=
# RF_OPERATOR_OIDC_AUDIENCE=
# RF_OPERATOR_OIDC_ISSUER=

# --- Operator voice gateway (server-side proxy) ---
RF_OPERATOR_VOICE_MODE=simulated
RF_OPERATOR_VOICE_STT_URL=http://127.0.0.1:9000/v1/audio/transcriptions
RF_OPERATOR_VOICE_TTS_URL=http://127.0.0.1:9000/v1/audio/speech
RF_OPERATOR_VOICE_API_KEY=
